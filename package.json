{
  "name": "weather-app",
  "version": "1.0.0",
  "description": "A weather app built for Apple devices with location services, Tailwind CSS and motion.js",
  "main": "index.html",
  "scripts": {
    "dev": "concurrently \"npx tailwindcss -i ./src/styles.css -o ./dist/style.css --watch --poll\" \"npx http-server dist -p 8080 --open\"",
    "build": "npx tailwindcss -i ./src/styles.css -o ./dist/style.css --minify",
    "start": "npx http-server dist -p 8080",
    "test": "NODE_ENV=test jest --coverage",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:coverage": "NODE_ENV=test jest --coverage --coverageReporters=text-summary"
  },
  "keywords": [
    "weather",
    "apple",
    "mobile-first"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "http-server": "^14.1.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^24.0.0",
    "tailwindcss": "^3.4.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": ["<rootDir>/jest.setup.js"],
    "testMatch": ["**/src/**/*.test.js"],
    "testPathIgnorePatterns": ["/node_modules/", "/dist/"],
    "collectCoverageFrom": [
      "<rootDir>/src/**/*.js",
      "!<rootDir>/src/styles.css"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 60,
        "functions": 60,
        "lines": 60,
        "statements": 60
      }
    },
    "moduleNameMapper": {
      "\\.(css|less|scss|sass)$": "identity-obj-proxy"
    }
  }
}
