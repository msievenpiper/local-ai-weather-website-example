{
  "name": "weather-app",
  "version": "1.0.0",
  "description": "A weather app built for Apple devices with location services, Tailwind CSS and motion.js",
  "main": "index.html",
  "scripts": {
    "dev": "npx tailwindcss -i ./src/styles.css -o ./dist/style.css --watch",
    "build": "npx tailwindcss -i ./src/styles.css -o ./dist/style.css --minify",
    "start": "npx http-server dist -p 8080"
  },
  "keywords": [
    "weather",
    "apple",
    "mobile-first"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "http-server": "^14.1.1",
    "tailwindcss": "^3.4.0"
  }
}
